# macOS
.DS_Store

# Xcode build output
build/
DerivedData/
*.xcuserstate
*.xcuserdatad

# Per-user Xcode state
xcuserdata/

# XcodeGen generates the Xcode project from project.yml (source of truth).
Hifz.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/

# Quran asset build cache (regenerated by Tools/build_quran_asset.py)
Tools/.cache/

# Claude Code settings — per-machine permission grants and absolute paths, not
# project configuration. Drop the leading `.claude/` entry if shared project
# settings (hooks, agents) are ever added here and should be tracked.
.claude/

# TokenSave's local code index and its config — per-machine tooling state, not
# part of the project.
.tokensave/
